def notebooks_using(notebooks, pvc_names):
    """Names of Notebook objects that mount any of these PVCs (they must all be tokenless)."""
    out = []
    for nb in notebooks:
        claims = {v["persistentVolumeClaim"]["claimName"]
                  for v in nb["spec"]["template"]["spec"].get("volumes") or [] if v.get("persistentVolumeClaim")}
        if claims & set(pvc_names):
            out.append(nb["metadata"]["name"])
    return sorted(out)


# ---------------------------------------------------------------- commands

def load(path):
    if not os.path.exists(path):
        raise Fail("%s not found; run `gqctl init --notebook <your-notebook>` first" % path)
    cfg = gqd.load_config(path)
    return {k: v for k, v in cfg.items() if not k.startswith("_")}


def cmd_init(a):
    if os.path.exists(a.config) and not a.force:
        raise Fail("%s exists; use --force to overwrite" % a.config)
    ns = ["-n", a.namespace] if a.namespace else []
    nb = kjson("get", "notebook", a.notebook, *ns)
    nbns = nb["metadata"]["namespace"]
    pd_list = kjson("get", "poddefaults", "-n", nbns, check=False)
    pds = pd_list["items"] if pd_list else None
    pvc_list = kjson("get", "pvc", "-n", nbns, check=False)
    pvc_info = {p["metadata"]["name"]: p.get("spec") or {} for p in pvc_list["items"]} if pvc_list else None
    selector = dict(kv.split("=", 1) for kv in a.node_selector or [])
    _, matched = poddefault_labels(nb["metadata"].get("labels") or {}, pds)
    zone = mlxp_zone(matched)

    # Node list: --nodes, else the MLXP Zone, else the nodes matching --node-selector (needs
    # permission to list nodes). None of these: scheduler-placement mode.
    nodes, node_objs = [n for n in (a.nodes or "").split(",") if n], []
    if not nodes and zone:
        z = kjson("get", MLXP_ZONE_RESOURCE, zone, check=False)
        nodes = ((z or {}).get("spec") or {}).get("nodes") or []
    if not nodes and selector:
        lst = kjson("get", "nodes", "-l", ",".join("%s=%s" % kv for kv in selector.items()), check=False)
        node_objs = (lst or {}).get("items") or []
        nodes = [n["metadata"]["name"] for n in node_objs]
    if nodes and not node_objs:
        node_objs = ((kjson("get", "nodes", *nodes, check=False) or {}).get("items") or []) if len(nodes) > 1 else \
            [x for x in [kjson("get", "node", nodes[0], check=False)] if x]
    capacity = None
    if a.node_capacity:
        g, cpu, mem = a.node_capacity.split(",")
        capacity = {"gpu": int(g), "cpu": float(cpu), "mem": mem}
    else:
        capacity = node_capacity_of(node_objs)
    cfg, warnings = discover(nb, pds, nodes=nodes, instance=a.instance, pvc_info=pvc_info,
                             node_capacity=capacity, node_selector=selector)
    with open(a.config, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    print("wrote %s for instance %r (namespace %s, platform %s)"
          % (a.config, cfg["instance"], cfg["namespace"], cfg["platform"]))
    print("  image    %s\n  root     %s\n  volumes  %s\n  excluded %s\n  labels   %s\n  zone     %s\n  nodes    %s"
          "\n  capacity %s per node"
          % (cfg["image"], cfg["root"], ", ".join("%s@%s" % (v["pvc"], v["mountPath"]) for v in cfg["volumes"]),
             ", ".join("%s@%s" % (v["pvc"], v["mountPath"]) for v in cfg["excluded_volumes"]) or "-",
             ", ".join("%s=%s" % kv for kv in cfg["pod_labels"].items()) or "-",
             cfg["zone"] or "-", ", ".join(cfg["nodes"]) or "- (scheduler-placement mode)",
             json.dumps(cfg["node_capacity"])))
    for w in warnings:
        print("  ! " + w)
    print("review the file (limits: max_gpus_total, max_running, ...), then: gqctl probe")
    return 0


def cmd_render(a):
    cfg = load(a.config)
    print(json.dumps({"apiVersion": "v1", "kind": "List",
                      "items": [render_deployment(cfg), render_probe(cfg, a.gpu)]}, indent=2))
    return 0


def cmd_probe(a):
    cfg = load(a.config)
    name = kubectl("create", "-f", "-", "-o", "name", stdin=json.dumps(render_probe(cfg, a.gpu))).strip()
    print("created %s; waiting up to 10 minutes ..." % name)
    r = subprocess.run(["kubectl", "wait", "-n", cfg["namespace"], name, "--for=condition=complete",
                        "--timeout=600s"], capture_output=True, text=True)
    out = kubectl("logs", "-n", cfg["namespace"], name, "-c", "main", check=False)
    print(out.rstrip())
    checks = {"GQ_PROBE_OK": "Job ran to the end", "PVC_WRITABLE": "PVC is writable as the image user",
              "NO_TOKEN": "pod has no Kubernetes token"}
    ok = r.returncode == 0 and all(k in out for k in checks)
    for k, what in checks.items():
        print("  %s %s" % ("ok " if k in out else "BAD", what))
    if r.returncode:
        print("  BAD Job did not complete: %s" % (r.stderr.strip() or r.stdout.strip()))
        print("      inspect: kubectl describe -n %s %s" % (cfg["namespace"], name))
    if "NO_K8S_CLIENT" in out and not cfg.get("gqd_image"):
        print("  !   the image has no `kubernetes` Python package; gqd needs it. Set \"gqd_image\" in %s "
              "to an image with python3 + kubernetes" % a.config)
        ok = False
    print("probe %s" % ("passed" if ok else "FAILED"))
    return 0 if ok else 1


def nb_target(cfg, a):
    return cfg["namespace"], a.pod or a.notebook + "-0", a.container or a.notebook


def nb_exec(ns, pod, ctr, argv, stdin=None, check=True):
    return kubectl("exec", "-i", "-n", ns, pod, "-c", ctr, "--", *argv, stdin=stdin, check=check)


def cmd_install(a):
    cfg = load(a.config)
    ns, pod, ctr = nb_target(cfg, a)
    rootd = cfg["root"]
    # The skill only has to persist in the notebook (agents read it there), so it goes under the
    # notebook user's own $HOME, which need not be shareable with Job pods.
    home = nb_exec(ns, pod, ctr, ["sh", "-c", 'printf %s "$HOME"']).strip() or "/root"
    claude_dir = a.skills_dir or posixpath.join(home, ".claude")
    skills = posixpath.join(claude_dir, "skills", "gq")
    nb_exec(ns, pod, ctr, ["mkdir", "-p", rootd + "/bin", rootd + "/spool", rootd + "/jobs", skills])
    kubectl("cp", os.path.join(HERE, "gq"), "%s/%s:%s/bin/gq" % (ns, pod, rootd), "-c", ctr)
    kubectl("cp", os.path.join(HERE, "skill", "SKILL.md"), "%s/%s:%s/SKILL.md" % (ns, pod, skills), "-c", ctr)
    nb_exec(ns, pod, ctr, ["chmod", "755", rootd + "/bin/gq"])
    nb_exec(ns, pod, ctr, ["sh", "-c", "cat > %s/env.sh" % shlex.quote(rootd)], stdin=render_env_sh(rootd))
    nb_exec(ns, pod, ctr, ["sh", "-c", "cat > %s/completion.bash" % shlex.quote(rootd)], stdin=completion_script())
    print("installed gq to %s/bin, %s/env.sh, and the agent skill to %s" % (rootd, rootd, skills))
    if a.no_shell_rc:
        print("shell rc left alone; add this to it yourself:\n  . %s/env.sh" % rootd)
    else:
        for ln in nb_exec(ns, pod, ctr, ["bash", "-s"], stdin=render_rc_script(rootd, a.shell_rc)).split("\n"):
            if ln.startswith("SKIP_SYMLINK"):
                print("  %s is a symlink (managed elsewhere); add this line there:\n    . %s/env.sh"
                      % (ln.split(" ", 1)[1], rootd))
            elif ln.strip():
                print("  shell rc: " + ln.lower().replace("_", " "))
    if not a.no_claude_settings:
        out = nb_exec(ns, pod, ctr, ["python3", "-", posixpath.join(claude_dir, "settings.json"),
                                     json.dumps(CLAUDE_RULES)], stdin=CLAUDE_SETTINGS_PY).strip()
        print("  claude settings: %s (allow gq, deny kubectl; backup *.before-gq)" % out.lower().replace("_", " "))
    print("open a new terminal in the notebook (or `source ~/.bashrc`) to pick up gq")
    return 0


def cmd_up(a):
    cfg = load(a.config)
    n, ns = names(cfg), cfg["namespace"]
    cm = kubectl("create", "configmap", n["configmap"], "-n", ns, "--from-file=gqd.py=" + os.path.join(HERE, "gqd.py"),
                 "--from-file=config.json=" + a.config, "--dry-run=client", "-o", "yaml")
    kubectl("apply", "-f", "-", stdin=cm)
    kubectl("apply", "-f", "-", stdin=json.dumps(render_deployment(cfg)))
    kubectl("rollout", "restart", "-n", ns, "deploy/" + n["deploy"])
    print(kubectl("rollout", "status", "-n", ns, "deploy/" + n["deploy"], "--timeout=300s").strip())
    print(kubectl("logs", "-n", ns, "deploy/" + n["deploy"], "-c", "gqd", "--tail=5", check=False).rstrip())
    return 0


def cmd_status(a):
    cfg = load(a.config)
    n, ns = names(cfg), cfg["namespace"]
    print(kubectl("get", "deploy,pods", "-n", ns, "-l", "gq-instance=" + cfg["instance"], check=False).rstrip())
    print(kubectl("get", "jobs", "-n", ns, "-l", "gq-instance=" + cfg["instance"], check=False).rstrip()
          or "(no gq jobs)")
    print(kubectl("logs", "-n", ns, "deploy/" + n["deploy"], "-c", "gqd", "--tail=10", check=False).rstrip())
    return 0


def cmd_logs(a):
    cfg = load(a.config)
    return subprocess.call(["kubectl", "logs", "-n", cfg["namespace"], "deploy/" + names(cfg)["deploy"],
                            "-c", "gqd", "--tail=100"] + (["-f"] if a.follow else []))


def pod_uid(ns, pod):
    obj = kjson("get", "pod", pod, "-n", ns, check=False)
    return obj["metadata"]["uid"] if obj and (obj.get("status") or {}).get("phase") == "Running" else None


def wait_restarted(ns, pod, old_uid, timeout=900):
    """Wait until the pod was replaced (new uid) and is Ready. Returns True on success."""
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        obj = kjson("get", "pod", pod, "-n", ns, check=False)
        if obj and obj["metadata"]["uid"] != old_uid and obj["metadata"].get("deletionTimestamp") is None:
            if any(c.get("type") == "Ready" and c.get("status") == "True"
                   for c in (obj.get("status") or {}).get("conditions") or []):
                return True
        time.sleep(5)
    return False


def locked(listed):
    """Notebooks whose pod template has automountServiceAccountToken explicitly false."""
    return [x["metadata"]["name"] for x in listed
            if ((x.get("spec") or {}).get("template") or {}).get("spec", {}).get("automountServiceAccountToken") is False]


def cmd_lockdown(a, undo=False):
    cfg = load(a.config)
    ns = cfg["namespace"]
    listed = kjson("get", "notebooks", "-n", ns)["items"]
    nbs = list(a.notebook or [])
    if a.prefix:
        nbs += [x["metadata"]["name"] for x in listed if x["metadata"]["name"].startswith(a.prefix)]
    if not nbs:  # default: lockdown -> every notebook on your shared volumes; unlock -> those of them locked
        nbs = notebooks_using(listed, [v["pvc"] for v in cfg["volumes"]])
        if undo:
            nbs = sorted(set(nbs) & set(locked(listed)))
    nbs = sorted(set(nbs))
    if not nbs:
        raise Fail("no locked notebooks on your volumes; nothing to unlock" if undo else
                   "no notebooks mount %s; nothing to lock down" % ", ".join(v["pvc"] for v in cfg["volumes"]))
    running = {nb: pod_uid(ns, nb + "-0") for nb in nbs}
    print(("will remove automountServiceAccountToken (token comes back) on: %s" if undo else
           "will set automountServiceAccountToken=false on: %s") % ", ".join(nbs))
    up = [nb for nb, uid in running.items() if uid]
    if up:
        print("these are running and will RESTART (tmux sessions, processes, --local gq jobs are lost): %s"
              % ", ".join(up))
    if not a.yes and input("continue? [y/N] ").strip().lower() != "y":
        print("aborted")
        return 1
    # unlock deletes the field (merge-patch null), which restores whatever the platform defaults to
    patch = json.dumps({"spec": {"template": {"spec": {"automountServiceAccountToken": None if undo else False}}}})
    for nb in nbs:
        kubectl("patch", "notebook", nb, "-n", ns, "--type", "merge", "-p", patch)
        print("patched %s" % nb)
    if a.no_wait or not up:
        print("stopped notebooks pick this up when they next start")
        return 0
    ok = True
    for nb in up:
        print("waiting for %s to restart ..." % nb)
        if not wait_restarted(ns, nb + "-0", running[nb]):
            print("  %s did not come back within 15 minutes; check it in the UI" % nb)
            ok = False
            continue
        out = nb_exec(ns, nb + "-0", nb, ["sh", "-c",
                      "test -e /var/run/secrets/kubernetes.io/serviceaccount/token && echo SA_TOKEN || echo NO_SA_TOKEN; "
                      "test -e /var/run/secrets/kubeflow/pipelines/token && echo KFP_TOKEN || echo NO_KFP_TOKEN"],
                      check=False)
        sa_gone = "NO_SA_TOKEN" in out
        if undo:
            print("  %s: service-account token %s" % (nb, "absent (the platform may not mount one by default)"
                                                       if sa_gone else "back"))
            continue
        ok = ok and sa_gone
        print("  %s: service-account token %s" % (nb, "removed" if sa_gone else "STILL PRESENT (a webhook may re-add it)"))
        if "KFP_TOKEN" in out.split():
            print("  %s: a Kubeflow Pipelines token is still mounted (injected by the platform; see DESIGN.md 12)" % nb)
    return 0 if ok else 1


HEARTBEAT_PY = r"""
import datetime, json, sys, time
p, deadline = sys.argv[1], time.time() + float(sys.argv[2])
while True:
    try:
        hb = json.load(open(p))
        ts = datetime.datetime.strptime(hb["ts"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
        age = (datetime.datetime.now(datetime.timezone.utc) - ts).total_seconds()
        if age < 30:
            print("HEARTBEAT_OK instance=%s age=%ds" % (hb.get("instance"), age)); sys.exit(0)
    except (OSError, ValueError, KeyError):
        pass
    if time.time() > deadline:
        print("HEARTBEAT_MISSING"); sys.exit(1)
    time.sleep(2)
"""


def verify(cfg, ns, pod, ctr, gpu):
    """From inside the notebook: gqd is alive, and real jobs run through gq end to end."""
    root = cfg["root"]
    out = nb_exec(ns, pod, ctr, ["python3", "-", root + "/gqd.heartbeat", "120"], stdin=HEARTBEAT_PY, check=False)
    if "HEARTBEAT_OK" not in out:
        raise Fail("no fresh gqd heartbeat in %s after 2 minutes; see `gqctl status`" % root)
    print("  gqd is alive (%s)" % out.strip().split(" ", 1)[1])
    gqbin = shlex.quote(root + "/bin/gq")
    prefix = "cd %s && GQ_ROOT=%s GQ_OWNER=gqctl-setup " % (shlex.quote(posixpath.dirname(root)), shlex.quote(root))
    checks = [("CPU job", "run --time 5m --wait-timeout 15m --name gq-setup -- echo gq-setup-ok", "gq-setup-ok")]
    if gpu:
        checks.append(("GPU job", "run --gpus 1 --time 10m --wait-timeout 30m --name gq-setup-gpu -- nvidia-smi -L",
                       "GPU 0"))
    for label, args, expect in checks:
        print("  running a %s through gq (waits for a free slot) ..." % label)
        r = subprocess.run(["kubectl", "exec", "-i", "-n", ns, pod, "-c", ctr, "--", "bash", "-c",
                            prefix + gqbin + " " + args], capture_output=True, text=True, timeout=3600)
        if r.returncode != 0 or expect not in r.stdout:
            raise Fail("%s through gq failed (exit %d):\n%s\n%s" % (label, r.returncode, r.stdout[-2000:], r.stderr[-2000:]))
        print("  ok: %s" % r.stdout.strip().splitlines()[-1])
    print(nb_exec(ns, pod, ctr, ["bash", "-c", "GQ_ROOT=%s %s capacity" % (shlex.quote(root), gqbin)],
                  check=False).rstrip())


def cmd_setup(a):
    print("== 1/5 config")
    if a.reinit or not os.path.exists(a.config):
        rc = cmd_init(argparse.Namespace(config=a.config, notebook=a.notebook, namespace=a.namespace,
                                         instance=a.instance, nodes=a.nodes, node_selector=a.node_selector,
                                         node_capacity=a.node_capacity, force=True))
        if rc:
            return rc
    else:
        print("using existing %s (--reinit to regenerate it)" % a.config)
    cfg = load(a.config)
    ns, pod, ctr = nb_target(cfg, a)
    if not pod_uid(ns, pod):
        raise Fail("%s is not running; start the notebook first (gq is installed and checked through it)" % pod)
    print("\n== 2/5 probe Job")
    if a.skip_probe:
        print("skipped")
    elif cmd_probe(argparse.Namespace(config=a.config, gpu=False)):
        return 1
    print("\n== 3/5 install gq into %s" % pod)
    cmd_install(argparse.Namespace(config=a.config, notebook=a.notebook, pod=a.pod, container=a.container,
                                   skills_dir=None, no_shell_rc=a.no_shell_rc, shell_rc=None,
                                   no_claude_settings=a.no_claude_settings))
    print("\n== 4/5 deploy gqd")
    cmd_up(argparse.Namespace(config=a.config))
    print("\n== 5/5 end-to-end check")
    verify(cfg, ns, pod, ctr, a.gpu)
    if a.lockdown:
        print("\n== lockdown")
        return cmd_lockdown(argparse.Namespace(config=a.config, notebook=None, prefix=None, yes=a.yes, no_wait=False))
    print("\ngq is ready. Last step, which restarts your running notebooks: ./gqctl lockdown")
    return 0


def cmd_down(a):
    cfg = load(a.config)
    n, ns = names(cfg), cfg["namespace"]
    kubectl("delete", "-n", ns, "deploy/" + n["deploy"], "configmap/" + n["configmap"], "--ignore-not-found")
    print("deleted gqd for instance %s" % cfg["instance"])
    if a.jobs:
        print(kubectl("delete", "jobs", "-n", ns, "-l", "gq-instance=" + cfg["instance"]).rstrip())
    return 0


def cmd_completion(a):
    sys.stdout.write(completion_script())
    return 0


def build_parser():
    ap = argparse.ArgumentParser(prog="gqctl", description=__doc__.split("\n\n")[0])
    ap.add_argument("--config", default="gq.config.json", help="instance config (default ./gq.config.json)")
    sub = ap.add_subparsers(dest="command", required=True)
    p = sub.add_parser("init", help="write the config from one of your notebooks")
    p.add_argument("--notebook", required=True)
    p.add_argument("--namespace", "-n")
    p.add_argument("--instance", help="short name used in resource names (default: notebook name prefix)")
    p.add_argument("--nodes", help="comma-separated GPU nodes gq may place on (default: MLXP zone nodes, "
                                   "or nodes matching --node-selector)")
    p.add_argument("--node-selector", action="append", metavar="KEY=VALUE",
                   help="label of your GPU nodes; added to Job pods and used to list nodes if you may")
    p.add_argument("--node-capacity", metavar="GPU,CPU,MEM",
                   help="size of one node, e.g. 8,125,1964Gi (default: read from nodes, or MLXP H200 size)")
    p.add_argument("--force", action="store_true")
    p = sub.add_parser("render", help="print the Deployment and probe Job as JSON")
    p.add_argument("--gpu", action="store_true")
    p = sub.add_parser("probe", help="run a one-off Job to check this setup works")
    p.add_argument("--gpu", action="store_true", help="also request one GPU and run nvidia-smi")
    p = sub.add_parser("install", help="copy the gq CLI and agent skill onto your PVC via a running notebook")
    p.add_argument("--notebook", required=True)
    p.add_argument("--pod", help="default <notebook>-0")
    p.add_argument("--container", help="default <notebook>")
    p.add_argument("--skills-dir", help="Claude Code config dir in the notebook (default $HOME/.claude there)")
    p.add_argument("--no-shell-rc", action="store_true", help="do not add the gq line to your shell rc")
    p.add_argument("--shell-rc", action="append", metavar="FILE",
                   help="rc file(s) to add the line to (default ~/.bashrc, and ~/.zshrc if present)")
    p.add_argument("--no-claude-settings", action="store_true",
                   help="do not add allow gq / deny kubectl to ~/.claude/settings.json")
    sub.add_parser("up", help="deploy or update gqd")
    sub.add_parser("status", help="gqd pod, gq Jobs and recent logs")
    p = sub.add_parser("logs", help="gqd logs")
    p.add_argument("-f", "--follow", action="store_true")
    p = sub.add_parser("lockdown", help="remove the Kubernetes token from your notebooks "
                                        "(default: all that mount your shared volumes)")
    p.add_argument("--notebook", action="append")
    p.add_argument("--prefix")
    p.add_argument("--yes", action="store_true")
    p.add_argument("--no-wait", action="store_true", help="do not wait for restarts and check the tokens")
    p = sub.add_parser("unlock", help="undo lockdown: give your notebooks their token back "
                                      "(default: the locked ones that mount your shared volumes)")
    p.add_argument("--notebook", action="append")
    p.add_argument("--prefix")
    p.add_argument("--yes", action="store_true")
    p.add_argument("--no-wait", action="store_true", help="do not wait for restarts and check the tokens")
    p = sub.add_parser("setup", help="all of it: init (if needed), probe, install, up, end-to-end check")
    p.add_argument("--notebook", required=True, help="your always-on notebook (must be running)")
    p.add_argument("--namespace", "-n")
    p.add_argument("--instance")
    p.add_argument("--nodes")
    p.add_argument("--node-selector", action="append", metavar="KEY=VALUE")
    p.add_argument("--node-capacity", metavar="GPU,CPU,MEM")
    p.add_argument("--reinit", action="store_true", help="regenerate the config even if it exists")
    p.add_argument("--skip-probe", action="store_true")
    p.add_argument("--gpu", action="store_true", help="also run a 1-GPU job through gq in the check")
    p.add_argument("--lockdown", action="store_true", help="finish with `gqctl lockdown` (restarts notebooks)")
    p.add_argument("--yes", action="store_true", help="do not ask before lockdown")
    p.add_argument("--pod")
    p.add_argument("--container")
    p.add_argument("--no-shell-rc", action="store_true")
    p.add_argument("--no-claude-settings", action="store_true")
    p = sub.add_parser("down", help="remove gqd")
    p.add_argument("--jobs", action="store_true", help="also delete this instance's Jobs")
    sub.add_parser("completion", help='print bash/zsh tab completion; e.g. eval "$(./gqctl completion)" in ~/.zshrc')
    return ap


def main(argv=None):
    a = build_parser().parse_args(argv)
    try:
        return {"init": cmd_init, "render": cmd_render, "probe": cmd_probe, "install": cmd_install, "up": cmd_up,
                "status": cmd_status, "logs": cmd_logs, "lockdown": cmd_lockdown,
                "unlock": lambda a: cmd_lockdown(a, undo=True), "setup": cmd_setup, "down": cmd_down,
                "completion": cmd_completion}[a.command](a)
    except (Fail, ValueError) as e:
        print("gqctl: error: %s" % e, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
