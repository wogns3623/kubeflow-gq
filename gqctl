CAP_KEYS = ("node_capacity", "cpu_job_default", "requests", "placement_grace", "deadline_slack",
            "max_gpus_total", "max_running", "max_queue", "max_array", "max_time", "max_wait_timeout",
            "max_gpus_per_job", "job_ttl_after_finished", "retention_days", "loop_interval",
            "metrics_interval", "gc_interval")

# MLXP (a multi-tenant Kubeflow platform) defaults: PodDefaults carry the zone in this
# annotation, the Zone object lists its nodes, and the notebook form's maximum per pod is
# the node size (H200 nodes: 8 GPUs, 125 cores, 1964Gi).
MLXP_ZONE_ANNOTATION = "mlx.navercorp.com/zone"
MLXP_ZONE_RESOURCE = "zones.management.mlx.navercorp.com"
MLXP_NODE_CAPACITY = {"gpu": 8, "cpu": 125, "mem": "1964Gi"}


class Fail(Exception):
    pass


def kubectl(*args, stdin=None, check=True):
    r = subprocess.run(["kubectl"] + list(args), input=stdin, text=True, capture_output=True)
    if check and r.returncode:
        raise Fail("kubectl %s failed:\n%s" % (" ".join(args), (r.stderr or r.stdout).strip()))
    return r.stdout


def kjson(*args, check=True):
    out = kubectl(*args, "-o", "json", check=check)
    return json.loads(out) if out.strip() else None


# ---------------------------------------------------------------- pure: discovery and rendering

def shareable(vol, info):
    """Can Job pods on other nodes mount this PVC while the notebook has it mounted?"""
    modes = set(info.get("accessModes") or [])
    return "ReadWriteMany" in modes or (vol.get("readOnly") and "ReadOnlyMany" in modes)


def poddefault_labels(nb_labels, pod_defaults):
    """Notebook labels that select PodDefaults (Kubeflow injects those into the notebook pod;
    Job pods get the same labels so they get the same defaults), and the matched PodDefaults.
    pod_defaults None (unreadable): fall back to MLXP's `<name>-pod-default: "true"` convention."""
    if pod_defaults is None:
        return {k: v for k, v in nb_labels.items() if k.endswith("-pod-default") and v == "true"}, []
    labels, matched = {}, []
    for pd in pod_defaults:
        sel = ((pd.get("spec") or {}).get("selector") or {}).get("matchLabels") or {}
        if sel and all(nb_labels.get(k) == v for k, v in sel.items()):
            labels.update(sel)
            matched.append(pd)
    return labels, matched


def mlxp_zone(matched_pod_defaults):
    for pd in matched_pod_defaults:
        zone = (pd["spec"].get("annotations") or {}).get(MLXP_ZONE_ANNOTATION)
        if zone:
            return zone
    return None


def node_capacity_of(nodes):
    """node_capacity from Node objects' allocatable (the smallest node), or None."""
    caps = []
    for n in nodes:
        a = (n.get("status") or {}).get("allocatable") or {}
        if a.get("nvidia.com/gpu"):
            caps.append({"gpu": int(a["nvidia.com/gpu"]), "cpu": gqd.parse_cpu(a.get("cpu", 0)),
                         "mem": gqd.fmt_mem(gqd.parse_mem(a.get("memory", 0)) // 2**30 * 2**30)})
    if not caps:
        return None
    small = min(caps, key=lambda c: (c["gpu"], c["cpu"]))
    return {"gpu": small["gpu"], "cpu": int(small["cpu"]), "mem": small["mem"]}


def discover(nb, pod_defaults, nodes=None, instance=None, pvc_info=None, node_capacity=None, node_selector=None):
    """Build an instance config from one of the user's Notebook objects.

    Copies the notebook's PVC mounts that pods on other nodes can share (ReadWriteMany;
    ReadOnlyMany for read-only mounts) so Job pods see the same paths; RWO and node-local
    volumes are listed under excluded_volumes. Takes the labels that select the notebook's
    PodDefaults, the image and the service account. On MLXP the matched PodDefaults name the
    zone. pvc_info: claim name -> PVC spec (accessModes, storageClassName), or None if PVCs
    could not be read. nodes empty = scheduler-placement mode. Returns (config, warnings)."""
    meta, spec = nb["metadata"], nb["spec"]["template"]["spec"]
    c = spec["containers"][0]
    pvcs = {v["name"]: v["persistentVolumeClaim"]["claimName"]
            for v in spec.get("volumes") or [] if v.get("persistentVolumeClaim")}
    mounted = []
    for m in c.get("volumeMounts") or []:
        if m["name"] in pvcs:
            v = {"pvc": pvcs[m["name"]], "mountPath": m["mountPath"]}
            for k in ("subPath", "readOnly"):
                if m.get(k):
                    v[k] = m[k]
            mounted.append(v)
    if not mounted:
        raise Fail("notebook %s mounts no PVC; gq needs a shared volume" % meta["name"])
    warnings = []
    if pvc_info is None:
        volumes, excluded = mounted, []
        warnings.append("could not read PVC access modes; assuming every volume is ReadWriteMany. "
                        "Remove volumes Job pods cannot mount (ReadWriteOnce, local-path) by hand")
    else:
        volumes, excluded = [], []
        for v in mounted:
            info = pvc_info.get(v["pvc"]) or {}
            if shareable(v, info):
                volumes.append(v)
            else:
                excluded.append(dict(v, accessModes=info.get("accessModes") or ["unknown"],
                                     storageClass=info.get("storageClassName")))
                warnings.append("%s (%s, %s) is left out: Job pods on other nodes cannot mount it, so files "
                                "under %s are not visible to jobs and gq refuses to run there"
                                % (v["pvc"], ",".join(info.get("accessModes") or ["unknown"]),
                                   info.get("storageClassName"), v["mountPath"]))
    if not [v for v in volumes if not v.get("readOnly")]:
        raise Fail("notebook %s has no writable ReadWriteMany PVC; gq needs one for its files and for "
                   "Job pods to see your work (create an RWX volume and mount it in the notebook)" % meta["name"])
    homes = [v for v in volumes if re.fullmatch(r"/home/[^/]+/?", v["mountPath"]) and not v.get("readOnly")]
    base = homes[0] if homes else min((v for v in volumes if not v.get("readOnly")),
                                      key=lambda v: len(v["mountPath"]), default=None)
    if base is None:
        raise Fail("all PVC mounts are read-only; gq needs a writable one")
    if not homes:
        warnings.append("no shareable PVC is mounted at a home directory; gq root is %s/gq, so set "
                        "GQ_ROOT in your shell (gqctl install prints the line)" % base["mountPath"].rstrip("/"))
    labels, matched = poddefault_labels(meta.get("labels") or {}, pod_defaults)
    if pod_defaults is None:
        warnings.append("could not read PodDefaults; copied the notebook's *-pod-default labels (MLXP style). "
                        "Check pod_labels")
    zone = mlxp_zone(matched)
    platform = "mlxp" if zone else "kubeflow"
    inst = instance or re.sub(r"[^a-z0-9-]", "", meta["name"].split("-")[0].lower())[:16].strip("-") or "me"
    cfg = {
        "instance": inst,
        "platform": platform,
        "namespace": meta["namespace"],
        "image": c["image"],
        "service_account": spec.get("serviceAccountName") or "default-editor",
        "pod_labels": labels,
        "node_selector": dict(node_selector or {}),
        "volumes": volumes,
        "excluded_volumes": excluded,
        "root": base["mountPath"].rstrip("/") + "/gq",
        "zone": zone,
        "nodes": list(nodes or []),
    }
    cfg.update({k: gqd.DEFAULTS[k] for k in CAP_KEYS})
    if node_capacity:
        cfg["node_capacity"] = node_capacity
    elif platform == "mlxp":
        cfg["node_capacity"] = dict(MLXP_NODE_CAPACITY)
        warnings.append("node_capacity set to %s, the MLXP H200 node size; change it if your zone's nodes differ"
                        % json.dumps(MLXP_NODE_CAPACITY))
    else:
        warnings.append("node_capacity is the default %s; set it to your GPU nodes' size (it also sets the "
                        "default CPU/memory limit per GPU)" % json.dumps(cfg["node_capacity"]))
    if not cfg["nodes"]:
        warnings.append("no node list (pass --nodes, or --node-selector if you may list nodes): scheduler-placement "
                        "mode, so gq cannot show free GPUs per node or avoid fragmentation, but jobs still run")
    return cfg, warnings


def names(cfg):
    return {"deploy": "gqd-" + cfg["instance"], "configmap": "gqd-" + cfg["instance"]}


def root_volume(cfg):
    v = gqd.mount_of(cfg["root"], cfg)
    rel = posixpath.relpath(posixpath.normpath(cfg["root"]), posixpath.normpath(v["mountPath"]))
    return v, posixpath.join(v.get("subPath") or "", rel)


def render_deployment(cfg):
    n, inst = names(cfg), cfg["instance"]
    vol, sub = root_volume(cfg)
    labels = {"app": n["deploy"], "gq-instance": inst}
    return {
        "apiVersion": "apps/v1", "kind": "Deployment",
        "metadata": {"name": n["deploy"], "namespace": cfg["namespace"], "labels": labels},
        "spec": {
            "replicas": 1,
            "strategy": {"type": "Recreate"},  # never two gqd for one instance
            "selector": {"matchLabels": labels},
            "template": {
                "metadata": {"labels": dict(labels, **cfg["pod_labels"])},
                "spec": {
                    "serviceAccountName": cfg.get("service_account", "default-editor"),  # the only token holder
                    "containers": [{
                        "name": "gqd",
                        "image": cfg.get("gqd_image") or cfg["image"],
                        "command": ["python3", "-I", "/opt/gqd/gqd.py", "--config", "/opt/gqd/config.json",
                                    "--root", "/gq"],
                        "env": [{"name": "PYTHONUNBUFFERED", "value": "1"}],
                        "resources": {"requests": {"cpu": "100m", "memory": "256Mi"},
                                      "limits": {"cpu": "1", "memory": "1Gi"}},
                        "volumeMounts": [{"name": "root", "mountPath": "/gq", "subPath": sub},  # only <root>
                                         {"name": "code", "mountPath": "/opt/gqd", "readOnly": True}],
                    }],
                    "volumes": [{"name": "root", "persistentVolumeClaim": {"claimName": vol["pvc"]}},
                                {"name": "code", "configMap": {"name": n["configmap"]}}],
                },
            },
        },
    }


def render_probe(cfg, gpu=False):
    v, _ = root_volume(cfg)
    script = ("id; test -w %s && echo PVC_WRITABLE || echo PVC_NOT_WRITABLE; "
              "ls /var/run/secrets/kubernetes.io >/dev/null 2>&1 && echo TOKEN_PRESENT || echo NO_TOKEN; "
              "python3 -c 'import kubernetes' 2>/dev/null && echo K8S_CLIENT_OK || echo NO_K8S_CLIENT; "
              "%secho GQ_PROBE_OK" % (shlex.quote(v["mountPath"]), "nvidia-smi -L && " if gpu else ""))
    limits = {"cpu": "1", "memory": "1Gi"}
    if gpu:
        limits["nvidia.com/gpu"] = "1"
    mounts = [dict({"name": "v%d" % i, "mountPath": x["mountPath"]},
                   **{k: x[k] for k in ("subPath", "readOnly") if x.get(k)}) for i, x in enumerate(cfg["volumes"])]
    labels = {"gq-probe": cfg["instance"]}
    return {
        "apiVersion": "batch/v1", "kind": "Job",
        "metadata": {"generateName": "gq-%s-probe-" % cfg["instance"], "namespace": cfg["namespace"],
                     "labels": labels},
        "spec": {
            "backoffLimit": 0, "activeDeadlineSeconds": 900, "ttlSecondsAfterFinished": 600,
            "template": {
                "metadata": {"labels": dict(labels, **cfg["pod_labels"])},
                "spec": {
                    "restartPolicy": "Never", "automountServiceAccountToken": False,
                    "containers": [{"name": "main", "image": cfg["image"], "command": ["bash", "-lc", script],
                                    "resources": {"requests": {"cpu": "1", "memory": "1Gi"}, "limits": limits},
                                    "volumeMounts": mounts}],
                    "volumes": [{"name": "v%d" % i, "persistentVolumeClaim": {"claimName": x["pvc"]}}
                                for i, x in enumerate(cfg["volumes"])],
                },
            },
        },
    }


