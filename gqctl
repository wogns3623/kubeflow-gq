RC_MARKER = "# added by gqctl (gq)"
CLAUDE_RULES = {"allow": ["Bash(gq *)"], "deny": ["Bash(kubectl *)"]}


def render_env_sh(root):
    """<root>/env.sh: the gq environment, sourced from the user's shell rc."""
    return ("# generated by gqctl: gq environment, sourced from your shell rc\n"
            "export GQ_ROOT=%s\n"
            'case ":$PATH:" in *":$GQ_ROOT/bin:"*) ;; *) export PATH="$GQ_ROOT/bin:$PATH" ;; esac\n'
            'case $- in *i*) [ -f "$GQ_ROOT/completion.bash" ] && . "$GQ_ROOT/completion.bash" ;; esac\n'
            % shlex.quote(root))


COMPLETION_HEAD = r'''# generated by gqctl: tab completion for gq and gqctl (bash, and zsh via bashcompinit)
if [ -n "$ZSH_VERSION" ]; then
  (( $+functions[compdef] )) || { autoload -Uz compinit && compinit -u; }
  autoload -U +X bashcompinit && bashcompinit
fi
_gq_ids() { ls "${GQ_ROOT:-$HOME/gq}/jobs" 2>/dev/null; }
'''

COMPLETION_FN = r'''_%(name)s_complete() {
  local cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD-1]} sub= i w
  local vals=" %(vals)s "
  for ((i=1; i<COMP_CWORD; i++)); do
    w=${COMP_WORDS[i]}
    [ "$w" = -- ] && return 0
    [ -z "$sub" ] && [[ $w != -* ]] && [[ $vals != *" ${COMP_WORDS[i-1]} "* ]] && sub=$w
  done
  [[ $vals == *" $prev "* ]] && return 0
  case $sub in
%(cases)s
    *) w= ;;
  esac
  COMPREPLY=($(compgen -W "$w" -- "$cur"))
}
complete -o bashdefault -o default -F _%(name)s_complete %(name)s
'''


def completion_script():
    """Tab completion for gq and gqctl, generated from their argparse parsers so it cannot drift.

    Completes subcommands and options; job ids for gq subcommands that take one; after an option
    that takes a value, or after `--`, the shell's default (file) completion takes over."""
    def opts(p):
        return [o for act in p._actions for o in act.option_strings]

    def vals(p):
        return [o for act in p._actions if act.option_strings and act.nargs != 0 for o in act.option_strings]

    gq = load_script("gq_cli", os.path.join(HERE, "gq"))
    out = [COMPLETION_HEAD]
    for name, ap in (("gq", gq.build_parser()), ("gqctl", build_parser())):
        subs = next(act for act in ap._actions if isinstance(act, argparse._SubParsersAction)).choices
        cases = ['    "") w="%s" ;;' % " ".join(list(subs) + opts(ap))]
        allv = set(vals(ap))
        for sn, sp in subs.items():
            allv |= set(vals(sp))
            ids = ' [[ $cur != -* ]] && w="$w $(_gq_ids)";' if any(a.dest == "id" for a in sp._actions) else ""
            cases.append('    %s) w="%s";%s ;;' % (sn, " ".join(opts(sp)), ids))
        out.append(COMPLETION_FN % {"name": name, "vals": " ".join(sorted(allv)), "cases": "\n".join(cases)})
    return "\n".join(out)


def load_script(name, path):
    loader = importlib.machinery.SourceFileLoader(name, path)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
    loader.exec_module(mod)
    return mod


def render_rc_script(root, rc_files=None):
    """bash for the notebook: add one marked line that sources <root>/env.sh to each rc file.

    Idempotent (the marker is looked for first). rc_files None: ~/.bashrc (created if missing)
    and ~/.zshrc if it exists. A symlinked rc file is managed elsewhere, so it is left alone
    and reported. Prints ADDED / PRESENT / SKIP_SYMLINK <file> per file."""
    line = "[ -f %s/env.sh ] && . %s/env.sh  %s" % (shlex.quote(root), shlex.quote(root), RC_MARKER)
    targets = [(f, True) for f in rc_files] if rc_files else [("$HOME/.bashrc", True), ("$HOME/.zshrc", False)]
    out = ["set -e", "line=%s" % shlex.quote(line)]
    for f, required in targets:
        path = f if f.startswith("$HOME") or f.startswith("/") else "$HOME/" + f
        out.append('f="%s"' % path)
        if not required:
            out.append('if [ -e "$f" ]; then')
        out.append('if [ -L "$f" ]; then echo "SKIP_SYMLINK $f"; '
                   'elif grep -qF %s "$f" 2>/dev/null; then echo "PRESENT $f"; '
                   'else printf "\\n%%s\\n" "$line" >> "$f"; echo "ADDED $f"; fi' % shlex.quote(RC_MARKER))
        if not required:
            out.append("fi")
    return "\n".join(out) + "\n"


